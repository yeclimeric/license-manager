# 生产环境配置示例（部署者唯一需要编辑的文件）
# 复制为 .env 后修改；.env 已被 .gitignore 忽略，不会进仓库。
# 敏感配置（DB 口令、JWT 密钥）在此定义一次，自动注入 MySQL 与后端，无需再改 config.prod.yaml。

# MySQL配置
MYSQL_ROOT_PASSWORD=your-strong-root-password
MYSQL_PASSWORD=your-strong-user-password
MYSQL_PORT=3306

# 应用端口配置（宿主机映射）
BACKEND_PORT=18888
FRONTEND_PORT=18880

# JWT 签名密钥：生产必须为强随机串。
# 可留空，运行 scripts/deploy-prepare.sh 会自动生成并写入；也可手动填 openssl rand -hex 32 的结果。
JWT_SECRET=
