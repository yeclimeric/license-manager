server:
  host: "0.0.0.0"
  port: 18888
  mode: "debug"

database:
  driver: "mysql"
  host: "REPLACE_ME"
  port: 3306
  username: "REPLACE_ME"
  password: "REPLACE_ME"
  database: "license_manager"
  charset: "utf8mb4"
  parse_time: true
  loc: "Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600
  auto_migrate: true

auth:
  jwt:
    secret: "license-manager-dev-secret-key-32-bytes"
    expire_hours: 1
    refresh_threshold_minutes: 30
  security:
    max_login_attempts: 5
    lockout_duration_minutes: 15

log:
  level: "info"
  format: "text"

i18n:
  enable: true
  default_lang: "zh-CN"
  # 相对路径基于工作目录。从 backend/ 启动时用 "configs/i18n/errors"；
  # 从 backend/cmd/ 启动（Docker 场景）才用 "../configs/i18n/errors"
  config_path: "configs/i18n/errors"
  support_langs: ["zh-CN", "en-US", "ja-JP"]

license:
  rsa:
    private_key_path: "configs/rsa_private_key.pem"
    public_key_path: "configs/rsa_public_key.pem"
    key_size: 2048

  heartbeat_timeout: 300
  offline_timeout: 1440
  expiring_days: 30
