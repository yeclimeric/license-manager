# 正式环境接口地址 - 自动匹配当前域名
# 留空表示使用相对路径（/api/xxx），由 nginx 反代到后端，同源无跨域问题
VITE_API_BASE_URL = ''

# 正式环境打包名称（输出目录）
# 默认 dist —— 与 Dockerfile.frontend、scripts/build-frontend.sh 保持一致，
# 产出 frontend/dist/，由 nginx 以根目录方式托管。
# 若需改为子路径部署（如 /production/），本项与下一项需同时调整，并同步修改 nginx 配置。
# 注：CI（.github/workflows/deploy_frontend.git.yml）部署到 /production/ 子路径，
#     在工作流中用 export 覆盖本项，不受此文件影响。
VITE_OUTDIR='dist'

# 正式环境地址前缀（资源引用 base）
# 默认根路径 / —— 资源引用形如 /static/js/xxx.js，
# 配合 nginx 的 `root` + `try_files $uri $uri/ /index.html` 使用。
# 若部署到子路径（如 /production/），改为 '/production/' 并让 nginx 用 alias 指向该目录。
VITE_ADDRESS_BASE_URL = '/'
